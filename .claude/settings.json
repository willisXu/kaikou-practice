{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(node team/tools/*)",
      "Bash(node --test *)",
      "Bash(npm test *)",
      "Bash(node test/run.js *)",
      "Bash(bash test/publish.sh *)",
      "Bash(npm run artifact *)",
      "Bash(node tools/artifact.js *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git stash *)",
      "Bash(git worktree list *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(*推送到GitHub*)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm publish *)",
      "Bash(rm *)",
      "Bash(git rm *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(/使用說明.txt)",
      "Edit(/team/architecture.rules.json)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.github/workflows/**)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/secrets/**)",
      "Edit(/.env)",
      "Edit(/.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-brief.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-irreversible.mjs\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-gate.mjs\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
